@model QuanLySuCoMayTinh.Models.PhieuTiepNhan
@{
    Layout = null;
    var daDanhGia = Model.DanhGiaDichVu != null;
    var thankYou = ViewBag.ThankYou == true;
    var errorMsg = ViewBag.ErrorMsg as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_SystemIcons" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đánh giá dịch vụ - Phiếu #HD-@Model.MaPhieu.ToString("D4")</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0f1c 0%, #101829 40%, #0d1424 100%);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* Background glow */
        body::before {
            content: '';
            position: fixed;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(234,179,8,0.12) 0%, transparent 70%);
            top: -100px; left: -100px;
            border-radius: 50%;
            pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(34,197,94,0.08) 0%, transparent 70%);
            bottom: -80px; right: -80px;
            border-radius: 50%;
            pointer-events: none;
        }

        .review-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 36px 32px;
            max-width: 480px;
            width: 100%;
            backdrop-filter: blur(20px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            position: relative;
            overflow: hidden;
        }

        .review-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, #eab308, #22c55e, #3b82f6);
        }

        .logo-area {
            text-align: center;
            margin-bottom: 24px;
        }
        .logo-icon {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #eab308, #f59e0b);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 8px 24px rgba(234,179,8,0.3);
            margin-bottom: 12px;
        }
        .logo-title {
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .logo-sub {
            font-size: 12.5px;
            color: rgba(255,255,255,0.45);
            margin-top: 4px;
        }

        .ticket-info {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 24px;
            font-size: 13px;
        }
        .ticket-info div {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
        }
        .ticket-info .label { color: rgba(255,255,255,0.45); }
        .ticket-info .value { color: #fff; font-weight: 500; }

        .stars-row {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 20px;
        }
        .star-btn {
            background: none;
            border: none;
            font-size: 36px;
            color: rgba(255,255,255,0.15);
            cursor: pointer;
            transition: all 0.2s;
            padding: 4px;
        }
        .star-btn.active { color: #facc15; transform: scale(1.1); }
        .star-btn:hover { transform: scale(1.2); }

        /* Thanh trượt mặt cười (lấy ý tưởng từ mẫu "Face-changing satisfaction slider") */
        .mood { --mc: #34d399; text-align: center; margin-bottom: 20px; }
        .mood[data-val="1"] { --mc: #f87171; } .mood[data-val="2"] { --mc: #fb923c; } .mood[data-val="3"] { --mc: #fbbf24; } .mood[data-val="4"] { --mc: #a3e635; }
        .mood-face { width: 112px; height: 112px; display: block; margin: 0 auto 6px; }
        .mood-bg { fill: var(--mc); transition: fill .3s ease; }
        .mood-eye { fill: #1c1917; }
        .mood-mouth { fill: none; stroke: #1c1917; stroke-width: 6; stroke-linecap: round; }
        .mood-label { font-size: 15px; font-weight: 700; color: var(--mc); margin-bottom: 14px; min-height: 22px; transition: color .3s ease; }
        .mood-range { -webkit-appearance: none; appearance: none; width: 100%; height: 8px; border-radius: 999px; outline: none; cursor: pointer;
            background: linear-gradient(90deg, #f87171, #fb923c, #fbbf24, #a3e635, #34d399); }
        .mood-range::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%; background: #fff; border: 4px solid var(--mc); box-shadow: 0 2px 8px rgba(0,0,0,.35); transition: border-color .3s ease, transform .15s ease; }
        .mood-range::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: #fff; border: 4px solid var(--mc); }
        .mood-range:active::-webkit-slider-thumb { transform: scale(1.12); }
        .mood-range:focus-visible { outline: 3px solid rgba(255,255,255,.5); outline-offset: 6px; }
        .mood-ticks { display: flex; justify-content: space-between; margin-top: 8px; font-size: 11px; color: rgba(255,255,255,0.45); }
        .mood-ticks span { cursor: pointer; flex: 1; }
        .mood-ticks span:first-child { text-align: left; } .mood-ticks span:last-child { text-align: right; }

        .comment-box {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            color: #fff;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            resize: vertical;
            min-height: 80px;
            outline: none;
            transition: border-color 0.2s;
            margin-bottom: 20px;
        }
        .comment-box:focus { border-color: rgba(234,179,8,0.5); }
        .comment-box::placeholder { color: rgba(255,255,255,0.25); }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #eab308, #f59e0b);
            border: none;
            border-radius: 12px;
            color: #000;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s;
            box-shadow: 0 6px 20px rgba(234,179,8,0.3);
        }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(234,179,8,0.45); }
        .submit-btn:active { transform: translateY(0); }

        /* Thank you / Already rated states */
        .result-icon {
            width: 80px; height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            margin: 0 auto 16px;
        }
        .result-title {
            font-size: 20px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 8px;
        }
        .result-sub {
            font-size: 13.5px;
            color: rgba(255,255,255,0.5);
            text-align: center;
            line-height: 1.5;
        }
        .stars-display {
            text-align: center;
            font-size: 28px;
            color: #facc15;
            margin: 16px 0;
            letter-spacing: 4px;
        }
    </style>
</head>
<body>
    <div class="review-card">
        <div class="logo-area">
            <div class="logo-icon">⭐</div>
            <div class="logo-title">Đánh giá dịch vụ</div>
            <div class="logo-sub">Smart Repair — Trung tâm sửa chữa máy tính</div>
        </div>

        <div class="ticket-info">
            <div>
                <span class="label">Mã phiếu</span>
                <span class="value">#HD-@Model.MaPhieu.ToString("D4")</span>
            </div>
            <div>
                <span class="label">Khách hàng</span>
                <span class="value">@(Model.ThietBi?.KhachHang?.HoTen ?? "Khách lẻ")</span>
            </div>
            <div>
                <span class="label">Thiết bị</span>
                <span class="value">@(Model.ThietBi?.TenTB ?? "—")</span>
            </div>
            <div>
                <span class="label">KTV phụ trách</span>
                <span class="value">@(Model.User_KTV?.FullName ?? "—")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div style="text-align:center; padding:20px 0;">
                <div class="result-icon" style="background:rgba(239,68,68,0.15);">
                    <i class="bi bi-exclamation-triangle" style="color:#ef4444;"></i>
                </div>
                <div class="result-title" style="color:#fca5a5;">Không thể đánh giá</div>
                <div class="result-sub">@errorMsg</div>
            </div>
        }
        else if (thankYou)
        {
            <!-- Trạng thái: Cảm ơn, vừa gửi thành công -->
            <div style="text-align:center; padding:20px 0;">
                <div class="result-icon" style="background:rgba(34,197,94,0.15);">
                    <i class="bi bi-check-circle-fill" style="color:#22c55e;"></i>
                </div>
                <div class="result-title" style="color:#4ade80;">Cảm ơn bạn!</div>
                <div class="stars-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= (Model.DanhGiaDichVu?.SoSao ?? 0) ? "bi-star-fill" : "bi-star")"></i>
                    }
                </div>
                <div class="result-sub">
                    Đánh giá của bạn đã được ghi nhận. <br/>
                    Phản hồi quý báu của bạn giúp chúng tôi cải thiện dịch vụ tốt hơn mỗi ngày! 🙏
                </div>
            </div>
        }
        else if (daDanhGia)
        {
            <!-- Trạng thái: Phiếu này đã được đánh giá trước đó -->
            <div style="text-align:center; padding:20px 0;">
                <div class="result-icon" style="background:rgba(234,179,8,0.15);">
                    <i class="bi bi-star-fill" style="color:#eab308;"></i>
                </div>
                <div class="result-title" style="color:#fbbf24;">Đã đánh giá</div>
                <div class="stars-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Model.DanhGiaDichVu!.SoSao ? "bi-star-fill" : "bi-star")"></i>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.DanhGiaDichVu.BinhLuan))
                {
                    <div style="font-size:14px; color:rgba(255,255,255,0.7); font-style:italic; margin-top:8px;">
                        "@Model.DanhGiaDichVu.BinhLuan"
                    </div>
                }
                <div class="result-sub" style="margin-top:12px;">
                    Phiếu này đã được đánh giá vào lúc @Model.DanhGiaDichVu.NgayDG.ToString("HH:mm, dd/MM/yyyy").<br/>
                    Cảm ơn bạn đã sử dụng dịch vụ của chúng tôi!
                </div>
            </div>
        }
        else
        {
            <!-- Trạng thái: Form đánh giá -->
            <form method="post" asp-action="DanhGiaPublic" asp-controller="PhieuTiepNhan">
                <input type="hidden" name="id" value="@Model.MaPhieu" />
                @Html.AntiForgeryToken()

                <div style="text-align:center; font-size:14px; color:rgba(255,255,255,0.6); margin-bottom:16px; font-weight:500;">
                    Bạn hài lòng với dịch vụ sửa chữa không?
                </div>

                <div class="mood" id="mood" data-val="5">
                    <svg class="mood-face" viewBox="0 0 120 120" aria-hidden="true">
                        <circle class="mood-bg" cx="60" cy="60" r="54"></circle>
                        <ellipse class="mood-eye" cx="43" cy="50" rx="5" ry="7"></ellipse>
                        <ellipse class="mood-eye" cx="77" cy="50" rx="5" ry="7"></ellipse>
                        <path class="mood-mouth" id="moodMouth" d="M38 72 Q60 102 82 72"></path>
                    </svg>
                    <div class="mood-label" id="starLabel" aria-live="polite">Tuyệt vời!</div>
                    <input type="range" class="mood-range" id="moodRange" min="1" max="5" step="1" value="5" aria-label="Mức hài lòng từ 1 đến 5">
                    <div class="mood-ticks" aria-hidden="true"><span data-val="1">Tệ</span><span data-val="2">Chưa tốt</span><span data-val="3">Bình thường</span><span data-val="4">Tốt</span><span data-val="5">Tuyệt vời</span></div>
                </div>
                <input type="hidden" name="soSao" id="soSaoInput" value="5" />

                <textarea name="binhLuan" class="comment-box" placeholder="Chia sẻ trải nghiệm của bạn (tùy chọn)..."></textarea>

                <button type="submit" class="submit-btn">
                    <i class="bi bi-send me-1"></i> Gửi đánh giá
                </button>
            </form>

            <script>
                const labels = { 1: 'Tệ', 2: 'Chưa tốt', 3: 'Bình thường', 4: 'Tốt', 5: 'Tuyệt vời!' };
                const mouth = { 1: [88, 60], 2: [84, 70], 3: [80, 80], 4: [76, 92], 5: [72, 102] };   // [y hai đầu miệng, y điểm điều khiển]
                const range = document.getElementById('moodRange');
                const input = document.getElementById('soSaoInput');
                const label = document.getElementById('starLabel');
                const mood = document.getElementById('mood');
                const path = document.getElementById('moodMouth');
                const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                let cur = mouth[5].slice(), raf = 0;

                function draw(a) { path.setAttribute('d', 'M38 ' + a[0].toFixed(1) + ' Q60 ' + a[1].toFixed(1) + ' 82 ' + a[0].toFixed(1)); }
                function morph(to) {
                    cancelAnimationFrame(raf);
                    if (reduce) { cur = to.slice(); draw(cur); return; }
                    const from = cur.slice(), t0 = performance.now();
                    (function step(t) {
                        const k = Math.min((t - t0) / 260, 1), e = 1 - Math.pow(1 - k, 3);
                        cur = [from[0] + (to[0] - from[0]) * e, from[1] + (to[1] - from[1]) * e];
                        draw(cur);
                        if (k < 1) raf = requestAnimationFrame(step);
                    })(t0);
                }
                function setVal(v) {
                    v = parseInt(v, 10);
                    input.value = v;              // giá trị gửi lên server vẫn là soSao 1–5 như trước
                    range.value = v;
                    label.textContent = labels[v];
                    mood.dataset.val = v;
                    range.setAttribute('aria-valuetext', labels[v]);
                    morph(mouth[v]);
                }
                range.addEventListener('input', () => setVal(range.value));
                document.querySelectorAll('.mood-ticks span').forEach(t => t.addEventListener('click', () => setVal(t.getAttribute('data-val'))));
                setVal(5);
            </script>
        }
    </div>
</body>
</html>
