@model QuanLySuCoMayTinh.Models.PhieuTiepNhan

@{
    ViewData["Title"] = "Chỉnh sửa Phiếu Tiếp Nhận";
}

<div class="helpdesk-breadcrumb">
    <span>Quản lý</span><span class="sep">›</span>
    <a href="@Url.Action("Index", "PhieuTiepNhan")" style="color:var(--text3);text-decoration:none">Tiếp nhận sự cố</a>
    <span class="sep">›</span><span class="cur">Chỉnh sửa</span>
</div>

<div class="helpdesk-page-header">
    <div>
        <div class="page-title">Chỉnh sửa phiếu #HD-@Model.MaPhieu.ToString("D4")</div>
        <div class="page-subtitle">Cập nhật thông tin và trạng thái xử lý của phiếu</div>
    </div>
    <a asp-action="Index" class="hd-btn hd-btn-outline hd-btn-sm" style="text-decoration:none">
        Quay lại
    </a>
</div>

<div class="hd-card" style="max-width: 600px;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaPhieu" />
            <input type="hidden" asp-for="NgayNhan" />
            <input type="hidden" asp-for="MaUser_KTV" />

            <div class="mb-4">
                <label asp-for="MaTB" class="form-label fw-bold" style="font-size: 13.5px; color: var(--text2);">Thiết bị / Khách hàng <span class="text-danger">*</span></label>
                <select asp-for="MaTB" class="form-select shadow-sm" asp-items="ViewBag.MaTB" style="font-size: 14px; border-radius: 8px; padding: 10px 15px;" required>
                    <option value="">-- Vui lòng chọn thiết bị --</option>
                </select>
            </div>

            <div class="mb-4">
                <label asp-for="TrangThai" class="form-label fw-bold" style="font-size: 13.5px; color: var(--text2);">Trạng thái xử lý <span class="text-danger">*</span></label>
                <select asp-for="TrangThai" class="form-select shadow-sm" style="font-size: 14px; border-radius: 8px; padding: 10px 15px;" required>
                    <option value="Chờ khám">Chờ khám</option>
                    <option value="Đang kiểm tra">Đang kiểm tra</option>
                    <option value="Đang sửa chữa">Đang sửa chữa</option>
                    <option value="Hoàn thành">Hoàn thành</option>
                </select>
            </div>

            <div class="alert alert-info mt-4" style="font-size: 13px; border-radius: 8px; border: 1px solid #BFDBFE; background-color: #EBF3FC; color: #1D4ED8;">
                Trạng thái hiện tại: <strong>@Model.TrangThai</strong>.
                <br>Kỹ thuật viên tiếp nhận: <strong>@Model.User_KTV?.FullName</strong>.
            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="hd-btn hd-btn-info px-4 py-2" style="font-size: 14px; background-color: var(--accent); color: white;">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>