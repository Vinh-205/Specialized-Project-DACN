@model QuanLySuCoMayTinh.Models.PhieuTiepNhan
<details class="card p-3 mb-3">
 <summary>Thông tin sự cố và xác minh sau sửa chữa</summary>
 <p>Mô tả ban đầu: @Model.MoTaSuCo</p><p>Phân loại: @Model.PhanLoaiYeuCau · Ưu tiên KTV: @Model.MucDoUuTien · AI đề xuất: @Model.MucDoUuTienDeXuat</p>
 @if (ViewBag.LichSuTrangThai is IEnumerable<QuanLySuCoMayTinh.Models.LichSuTrangThai> lsAi && lsAi.Any(x => x.LoaiSuKien == "AI_TU_CHOT"))
 {
  <p><strong>AI đã tự chốt mã lỗi</strong> khi độ tin cậy Cao (@(Model.MaLoiNavigation?.TenLoi)). Chưa có người xác minh nguyên nhân; KTV kiểm tra lại trước khi chốt phí.</p>
 }
 @if (ViewBag.KhaNangSua is QuanLySuCoMayTinh.Services.KhaNangSuaDuDoan kn)
 {
  <p title="Mô hình học máy huấn luyện trên mô tả sửa chữa thật (Open Repair Alliance); mạng nơ-ron MLP, độ chính xác khoảng 65% trên tập giữ riêng, chỉ để tham khảo">AI dự đoán khả năng sửa: <strong>@kn.NhanHienThi</strong> (@((kn.XacSuat * 100).ToString("0"))%) · chỉ tham khảo, KTV quyết định</p>
 }
 <p>Chốt phí không tự xác minh nguyên nhân. Chỉ xác nhận khi đã có kiểm tra lại đạt và bằng chứng phù hợp.</p>
 @foreach(var repair in Model.ChiTietSuaChuas) {
  <form asp-controller="ChiTietSuaChua" asp-action="CapNhatKiemTraLai" method="post" class="border p-2 mb-2">
   <input type="hidden" name="maCT" value="@repair.MaCT" />
   <strong>@repair.TenHangMuc</strong><span> · @repair.TrangThaiKiemTraLai</span>
   <select name="trangThai" class="form-select"><option value="Đạt">Đạt</option><option value="Không đạt">Không đạt</option></select>
   <input name="bangChung" maxlength="1000" required class="form-control" placeholder="Tham chiếu bằng chứng kiểm tra lại" />
   <button class="btn btn-outline-primary" type="submit">Lưu kiểm tra lại</button>
  </form>
 }
 @if(ViewBag.LichSuChanDoan is IEnumerable<QuanLySuCoMayTinh.Models.LichSuChanDoan> histories) {
  foreach(var h in histories) {
   <form asp-controller="TroLyChanDoan" asp-action="XacMinhNguyenNhan" method="post" class="border p-2 mb-2">
    <input type="hidden" name="maLichSuChanDoan" value="@h.MaLichSuChanDoan" />
    <span>Lần chẩn đoán #@h.MaLichSuChanDoan · @h.TrangThaiXacMinh</span>
    <select name="maLoiThucTe" required class="form-select"><option value="">Chọn nguyên nhân sau kiểm tra, không tự lấy dự đoán AI</option>
    @foreach(var fault in (IEnumerable<QuanLySuCoMayTinh.Models.MaLoi>)ViewBag.MaLoiXacMinh){<option value="@fault.MaLoiID">@fault.TenLoi</option>}
    </select><button class="btn btn-outline-success" type="submit">Xác minh nguyên nhân thực tế</button>
   </form>
  }
 }
</details>

@{
    ViewData["Title"] = "Chi tiết phiếu tiếp nhận";
}

<div class="helpdesk-breadcrumb d-print-none">
    <span>Quản lý</span><span class="sep">›</span>
    <a href="@Url.Action("Index", "PhieuTiepNhan")" style="color:var(--text3);text-decoration:none">Tiếp nhận sự cố</a>
    <span class="sep">›</span><span class="cur">Chi tiết phiếu</span>
</div>

<div class="helpdesk-page-header d-print-none">
    <div>
        <div class="page-title">Chi tiết Phiếu #HD-@Model.MaPhieu.ToString("D4")</div>
        <div class="page-subtitle">Xem toàn bộ quá trình xử lý và phí dịch vụ</div>
    </div>
    <div class="header-actions">
        <!-- Nút Nhận ca kiểm tra (Bước 2) -->
        @if (Model.TrangThai == "Chờ khám")
        {
            <form asp-action="NhanCa" method="post" style="display:inline;">
                <input type="hidden" name="id" value="@Model.MaPhieu" />
                <button type="submit" class="hd-btn hd-btn-primary hd-btn-sm" style="border:none;">
                    <i class="bi bi-person-check"></i> Nhận ca kiểm tra
                </button>
            </form>
        }

        @if (Model.TrangThai == "Đang kiểm tra" || Model.TrangThai == "Đang sửa chữa")
        {
            <a asp-controller="TroLyChanDoan" asp-action="Index" asp-route-maPhieu="@Model.MaPhieu" class="hd-btn hd-btn-primary hd-btn-sm" style="text-decoration:none">
                <i class="bi bi-robot"></i> @(Model.MaLoi_CD.HasValue ? "Chẩn đoán lại" : "Chẩn đoán")
            </a>
        }
        @if (Model.TrangThai == "Đang sửa chữa")
        {
            <a asp-action="ChotPhi" asp-route-id="@Model.MaPhieu" class="hd-btn hd-btn-success hd-btn-sm" style="text-decoration:none">
                Chốt phí
            </a>
        }
        <a href="@Url.Action("Print", "PhieuTiepNhan", new { id = Model.MaPhieu, type = "bm01" })" target="_blank" class="hd-btn hd-btn-outline hd-btn-sm" style="text-decoration:none" title="In Phiếu Tiếp Nhận (BM-01)">
            <i class="bi bi-file-earmark-pdf"></i> Xuất PDF / In Phiếu Nhận
        </a>
        <a href="@Url.Action("Print", "PhieuTiepNhan", new { id = Model.MaPhieu, type = "bm02" })" target="_blank" class="hd-btn hd-btn-outline hd-btn-sm" style="text-decoration:none" title="In Phiếu Yêu Cầu Xuất Kho (BM-02)">
            <i class="bi bi-file-earmark-pdf"></i> Xuất PDF / In Xuất Kho
        </a>
        @if (Model.TrangThai == "Hoàn thành")
        {
            <a href="@Url.Action("Print", "PhieuTiepNhan", new { id = Model.MaPhieu, type = "bm03" })" target="_blank" class="hd-btn hd-btn-outline hd-btn-sm" style="text-decoration:none" title="In Hóa Đơn Thanh Toán (BM-03)">
                <i class="bi bi-file-earmark-pdf"></i> Xuất PDF / In Hóa Đơn
            </a>
        }
        @if (Model.TrangThai != "Hoàn thành")
        {
            <a asp-action="Edit" asp-route-id="@Model.MaPhieu" class="hd-btn hd-btn-outline hd-btn-sm" style="text-decoration:none">Sửa</a>
        }
        <a asp-action="Index" class="hd-btn hd-btn-outline hd-btn-sm" style="text-decoration:none">
            Quay lại
        </a>
    </div>
</div>

@if (Model.TrangThai == "Hoàn thành")
{
    <div class="alert mb-4 d-print-none" style="background:rgba(234,179,8,0.1); border:1px solid rgba(234,179,8,0.3); color:#facc15; border-radius:10px; display:flex; align-items:center; gap:12px;">
        <i class="bi bi-lock-fill" style="font-size:20px;"></i>
        <div>
            <div class="fw-bold" style="font-size:14.5px;">Hồ sơ đã khóa</div>
            <div style="font-size:13px; color:rgba(250,204,21,0.7);">Phiếu này đã được thanh toán và hoàn tất. Các thao tác sửa đổi, xuất kho đã bị khóa để bảo toàn số liệu kế toán.</div>
        </div>
    </div>
}

<div class="row">
    <!-- CỘT TRÁI: THÔNG TIN PHIẾU -->
    <div class="col-md-8">
        <div class="hd-card mb-4">
            <div class="hd-card-header">
                <span class="hd-card-title">Thông tin sự cố</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">Khách hàng:</div>
                    <div class="col-md-8 fw-bold" style="color:var(--text);">@(Model.ThietBi?.KhachHang?.HoTen ?? "Khách lẻ") - @Model.ThietBi?.KhachHang?.SDT</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">Thiết bị cần sửa:</div>
                    <div class="col-md-8 fw-bold" style="color:var(--c-info);">@Model.ThietBi?.TenTB</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ThietBi?.CauHinh))
                {
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">Cấu hình:</div>
                    <div class="col-md-8" style="color:var(--text); font-size:13.5px;">@Model.ThietBi?.CauHinh</div>
                </div>
                }
                @if (!string.IsNullOrEmpty(Model.ThietBi?.NgoaiQuan))
                {
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">Ngoại quan:</div>
                    <div class="col-md-8" style="color:var(--text); font-size:13.5px;">@Model.ThietBi?.NgoaiQuan</div>
                </div>
                }
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">Ngày nhận máy:</div>
                    <div class="col-md-8" style="color:var(--text); display:flex; align-items:center; gap:10px;">
                        @Model.NgayNhan.ToString("dd/MM/yyyy HH:mm")
                        @if (Model.TrangThai == "Chờ khám")
                        {
                            <span id="sla-timer" data-start="@Model.NgayNhan.ToString("O")" class="hd-badge hd-badge-gray" style="font-family:'JetBrains Mono', monospace; font-size:11px;">00:00:00</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">KTV Phụ trách:</div>
                    <div class="col-md-8" style="color:var(--text);">@(Model.User_KTV?.FullName ?? "Hệ thống / N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4 fw-bold" style="color:var(--text-muted);">Chẩn đoán từ AI:</div>
                    <div class="col-md-8 fw-bold" style="color:var(--c-err);">
                        @(Model.MaLoiNavigation?.TenLoi ?? "Chưa có chẩn đoán hoặc không xác định")
                    </div>
                </div>
            </div>
        </div>

        <!-- CHI TIẾT SỬA CHỮA VÀ BÁO GIÁ -->
        @if (Model.TrangThai != "Chờ khám")
        {
            <div class="hd-card" style="border-top:2px solid #22c55e;">
                <div class="hd-card-header d-flex justify-content-between align-items-center" style="background:rgba(34,197,94,0.1);border-bottom:1px solid rgba(34,197,94,0.2);">
                    <span class="hd-card-title" style="color:var(--c-ok)!important;">Nội dung sửa chữa & Chi phí</span>
                    @if (Model.TrangThai == "Đang sửa chữa")
                    {
                        <button type="button" onclick="openPartModal()" class="hd-btn hd-btn-sm" style="background:linear-gradient(135deg,#22c55e,#10b981); color:#fff; border:none; padding:5px 12px; border-radius:6px; font-size:12px; font-weight:600;">
                            <i class="bi bi-plus-circle"></i> Thêm linh kiện
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0" style="--bs-table-bg: transparent; color:var(--text);">
                        <thead style="background:var(--surface2);">
                            <tr>
                                <th class="ps-4" style="color:var(--text-muted);border-bottom:1px solid var(--border);">Hạng mục đã thực hiện</th>
                                <th class="text-end pe-4" style="color:var(--text-muted);border-bottom:1px solid var(--border);">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ChiTietSuaChuas != null && Model.ChiTietSuaChuas.Any())
                            {
                                foreach (var item in Model.ChiTietSuaChuas)
                                {
                                    <tr>
                                        <td class="ps-4" style="color:var(--text);border-bottom:1px solid var(--border);">
                                            @item.TenHangMuc
                                            @if (item.SuDungLinhKiens != null && item.SuDungLinhKiens.Any())
                                            {
                                                <div style="font-size:12px; color:var(--text-muted); margin-top:4px;">
                                                    @foreach (var sd in item.SuDungLinhKiens)
                                                    {
                                                        <div>- @sd.SoLuong x @sd.LinhKien?.TenLK (@string.Format("{0:N0} đ", sd.DonGiaXuat))</div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="text-end fw-bold pe-4" style="color:var(--c-err);border-bottom:1px solid var(--border);">
                                            @string.Format("{0:N0} đ", item.ChiPhi)
                                            @if (Model.TrangThai == "Đang sửa chữa" && item.SuDungLinhKiens != null && item.SuDungLinhKiens.Any())
                                            {
                                                var sd = item.SuDungLinhKiens.First();
                                                <form asp-controller="SuDungLinhKien" asp-action="HoanKho" method="post" style="display:inline; margin-left:10px;" onsubmit="return confirm('Bạn có chắc muốn hoàn trả linh kiện này về kho?');">
                                                    <input type="hidden" name="MaCT" value="@sd.MaCT" />
                                                    <input type="hidden" name="MaLK" value="@sd.MaLK" />
                                                    <input type="hidden" name="MaPhieu" value="@Model.MaPhieu" />
                                                    <button type="submit" class="btn btn-link text-danger p-0 border-0"><i class="bi bi-trash"></i></button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="ps-4" style="color:var(--text);border-bottom:1px solid var(--border);">Đã hoàn thành sửa chữa (Vui lòng thiết lập cấu hình Database)</td>
                                    <td class="text-end fw-bold pe-4" style="color:var(--c-err);border-bottom:1px solid var(--border);">Chưa có phí</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (Model.ChiTietSuaChuas != null && Model.ChiTietSuaChuas.Any())
                    {
                        var tongPhi = Model.ChiTietSuaChuas.Sum(ct => ct.ChiPhi);
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 20px 12px 16px; background:rgba(34,197,94,0.07); border-top:1px solid rgba(34,197,94,0.2);">
                            <span style="font-size:13px; color:var(--text-muted);">
                                <i class="bi bi-calculator me-1" style="color:var(--c-ok);"></i>
                                Tổng chi phí hiện tại
                                <small style="color:var(--text-muted);">(chưa tính tiền công)</small>
                            </span>
                            <span style="font-family:'JetBrains Mono',monospace; font-size:16px; font-weight:700; color:var(--c-ok);">
                                @string.Format("{0:N0} đ", tongPhi)
                            </span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ===== SECTION: HÌNH ẢNH SỰ CỐ (Chứng cứ tiếp nhận) ===== -->
        <div class="hd-card mt-4 d-print-none">
            <div class="hd-card-header" style="display:flex; align-items:center; justify-content:space-between;">
                <span class="hd-card-title">
                    <i class="bi bi-images me-2" style="color:var(--primary);"></i> Hình ảnh sự cố
                </span>
                <div style="display:flex; gap:8px; align-items:center;">
                    @if (Model.TrangThai != "Hoàn thành")
                    {
                        <!-- Nút QR Upload -->
                        <button type="button" onclick="openQrModal()" title="Quét QR để upload từ điện thoại"
                                style="background:var(--surface2); border:1px solid var(--border); color:var(--c-purple); padding:7px 12px; border-radius:7px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px; transition:all 0.2s;">
                            <i class="bi bi-qr-code"></i> QR Upload
                        </button>
                        <!-- Nút upload thường -->
                        <button type="button" onclick="openUploadModal()" class="hd-btn hd-btn-sm" style="background:var(--primary); color:var(--on-primary); border:none; padding:7px 14px; border-radius:999px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px; transition:all 0.2s;">
                            <i class="bi bi-camera-fill"></i> Thêm ảnh chứng cứ
                        </button>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                @if (Model.HinhAnhSuCos != null && Model.HinhAnhSuCos.Any())
                {
                    <div id="photoGrid" style="display:flex; flex-wrap:wrap; gap:8px;">
                        @foreach (var ha in Model.HinhAnhSuCos.OrderByDescending(h => h.NgayChup))
                        {
                            <div class="photo-card" style="width:140px; position:relative; border-radius:8px; overflow:hidden; border:1px solid var(--border); background:rgba(0,0,0,0.2); cursor:pointer; transition:transform 0.2s;"
                                 onclick="viewPhoto('@ha.DuongDanAnh', '@(ha.MoTa ?? "")')">
                                <img src="/@ha.DuongDanAnh" alt="@ha.MoTa"
                                     style="width:100%; aspect-ratio:4/3; object-fit:cover; display:block;" />
                                <div style="padding:8px; background:rgba(0,0,0,0.5);">
                                    <div style="font-size:11px; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@(ha.MoTa ?? "Ảnh sự cố")</div>
                                    <div style="font-size:10px; color:var(--text-muted);">@ha.NgayChup.ToString("dd/MM HH:mm")</div>
                                </div>
                                @if (Model.TrangThai != "Hoàn thành")
                                {
                                    <button class="photo-delete-btn" title="Xóa ảnh" onclick="event.stopPropagation(); deletePhoto(@ha.MaHA)"
                                            style="position:absolute; top:6px; right:6px; width:24px; height:24px; border-radius:50%; background:rgba(239,68,68,0.8); border:none; color:#fff; font-size:11px; cursor:pointer; display:none; align-items:center; justify-content:center;">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div id="photoEmptyState" style="text-align:center; padding:40px 20px; color:var(--text-light);">
                        <i class="bi bi-camera" style="font-size:40px; opacity:0.4; display:block; margin-bottom:10px;"></i>
                        <div style="font-size:14px; font-weight:500; color:var(--text-muted);">Chưa có hình ảnh sự cố</div>
                        <div style="font-size:12px; margin-top:4px;">Nhấn "Thêm ảnh chứng cứ" để đính kèm ảnh thiết bị</div>
                    </div>
                }
            </div>
        </div>
        <!-- ===== GHI CHÚ NỘI BỘ KTV ===== -->
        @if (User.IsInRole("Admin KTV") || User.IsInRole("KTV"))
        {
            <div class="hd-card mt-4 mb-4" style="border-top:2px solid #14b8a6;">
                <div class="hd-card-header" style="background:rgba(20,184,166,0.1); border-bottom:1px solid rgba(20,184,166,0.2);">
                    <span class="hd-card-title" style="color:var(--c-info)!important;"><i class="bi bi-journal-text me-2"></i> Ghi chú nội bộ (Chỉ KTV/Admin xem)</span>
                </div>
                <div class="hd-card-body p-3">
                    <form asp-action="UpdateGhiChuNoiBo" method="post" id="form-ghi-chu">
                        <input type="hidden" name="id" value="@Model.MaPhieu" />
                        <div class="mb-2">
                            <textarea name="ghiChu" class="hd-modal-textarea hd-modal-input" rows="3" placeholder="Nhập ghi chú ẩn cho nội bộ (khách hàng không thấy)..." style="background:rgba(0,0,0,0.2); border-color:rgba(20,184,166,0.3);">@Model.GhiChuNoiBo</textarea>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="hd-btn hd-btn-sm" style="background:#0f766e; color:#fff; border:none;"><i class="bi bi-save"></i> Lưu ghi chú</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- CỘT PHẢI: TIẾN TRÌNH XỬ LÝ -->
    <div class="col-md-4 d-print-none">
        <div class="hd-card mb-4">
            <div class="hd-card-header">
                <span class="hd-card-title">Nhật ký tiến độ</span>
            </div>
            <div class="card-body p-4">
                @{
                    var history = ViewBag.LichSuTrangThai as List<QuanLySuCoMayTinh.Models.LichSuTrangThai> ?? new List<QuanLySuCoMayTinh.Models.LichSuTrangThai>();
                    bool isFirst = true;
                }
                
                @if (history.Any())
                {
                    foreach (var h in history)
                    {
                        var color = h.TrangThaiMoi switch
                        {
                            "Hoàn thành" => "#4ade80",
                            "Đang sửa chữa" => "#fde047",
                            "Đang kiểm tra" => "#a855f7",
                            _ => "#38bdf8"
                        };

                        <div class="position-relative @(!isFirst ? "border-start border-2 ms-2 ps-3 pb-4" : "ms-2 ps-3 pb-2")" style="border-color:@color!important;">
                            <div class="position-absolute rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 0; background:@color;"></div>
                            <p class="fw-bold mb-1" style="color:@color;">@h.TrangThaiMoi</p>
                            <div style="font-size:12px; color:var(--text-muted);">@h.ThoiGian.ToString("dd/MM/yyyy HH:mm")</div>
                            <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                                <i class="bi bi-person"></i> @(h.KTV?.FullName ?? "Hệ thống")
                            </div>
                        </div>
                        isFirst = false;
                    }
                }
                
                <!-- Gốc: Tiếp nhận thiết bị -->
                <div class="position-relative border-start border-2 ms-2 ps-3 pb-4" style="border-color:#38bdf8!important;">
                    <div class="position-absolute rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 0; background:#38bdf8;"></div>
                    <p class="fw-bold mb-1" style="color:var(--c-info);">Tiếp nhận (Chờ khám)</p>
                    <small style="color:var(--text-muted);">@Model.NgayNhan.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            </div>
        </div>

        <!-- BƯỚC 5: ĐÁNH GIÁ DỊCH VỤ -->
        @if (Model.TrangThai == "Hoàn thành")
        {
            <div class="hd-card" style="border:1px solid rgba(234,179,8,0.3);">
                <div class="hd-card-header d-flex align-items-center gap-2" style="background:rgba(234,179,8,0.1);">
                    <i class="bi bi-star-fill text-warning"></i>
                    <span class="hd-card-title text-warning">Đánh giá dịch vụ</span>
                </div>
                <div class="card-body p-4">
                    @if (Model.DanhGiaDichVu != null)
                    {
                        <div class="text-center">
                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= Model.DanhGiaDichVu.SoSao ? "bi-star-fill" : "bi-star")" style="color:#facc15; font-size:24px; margin:0 4px;"></i>
                                }
                            </div>
                            <div style="color:var(--text); font-size:14px; font-weight:500;">"@Model.DanhGiaDichVu.BinhLuan"</div>
                            <div style="font-size:12px; color:var(--text-muted); margin-top:8px;">
                                Gửi lúc: @Model.DanhGiaDichVu.NgayDG.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; margin:10px 0; padding:16px; border:2px dashed rgba(234,179,8,0.4); border-radius:10px; background:rgba(234,179,8,0.05);">
                            <div id="qrReviewDetails" style="padding:10px; background:#fff; border-radius:8px;"></div>
                            <div style="text-align:center;">
                                <div style="font-size:14px; font-weight:700; color:#facc15; margin-bottom:4px;">📱 Khách hàng quét mã QR để đánh giá</div>
                                <div style="font-size:12px; color:var(--text-muted); line-height:1.5;">
                                    Hoặc KTV có thể mở <a href="@Url.Action("Print", new { id = Model.MaPhieu, type = "bm01" })" target="_blank" style="color:var(--primary); text-decoration:none;">Trang In Hóa Đơn</a> để xem mã.
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        </div>
    </div>
</div>

<!-- ===== MODAL: UPLOAD HÌNH ẢNH ===== -->
<div id="uploadModal" style="display:none; position:fixed; inset:0; z-index:9998; background:rgba(0,0,0,0.65); backdrop-filter:blur(6px); align-items:center; justify-content:center;">
    <div style="background:#13131f; border:1px solid rgba(168,85,247,0.3); border-radius:18px; padding:0; max-width:480px; width:92%; box-shadow:0 24px 70px rgba(0,0,0,0.6); overflow:hidden;">

        <!-- Modal Header -->
        <div style="padding:18px 22px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; background:rgba(168,85,247,0.08);">
            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:36px; height:36px; background:var(--tint); color:var(--tint-x); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:16px;">
                    <i class="bi bi-camera-fill"></i>
                </div>
                <div>
                    <div style="font-size:15px; font-weight:700; color:var(--text);">Thêm ảnh chứng cứ</div>
                    <div style="font-size:11.5px; color:var(--text-muted);">Phiếu #@Model.MaPhieu.ToString("D4")</div>
                </div>
            </div>
            <button onclick="closeUploadModal()" style="background:var(--surface2); border:1px solid var(--border); border-radius:6px; width:30px; height:30px; color:var(--text-muted); cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center; transition:all 0.2s;">&times;</button>
        </div>

        <!-- Modal Body: Upload Form -->
        <form id="uploadForm" asp-controller="HinhAnhSuCo" asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaPhieu" value="@Model.MaPhieu" />

            <div style="padding:22px;">
                <!-- Drop zone -->
                <div id="dropZone" style="border:2px dashed rgba(168,85,247,0.35); border-radius:12px; padding:32px; text-align:center; cursor:pointer; transition:all 0.2s; background:rgba(168,85,247,0.04); margin-bottom:16px;"
                     onclick="document.getElementById('fileInput').click()"
                     ondragover="event.preventDefault(); this.style.borderColor='#a855f7'; this.style.background='rgba(168,85,247,0.1)'"
                     ondragleave="this.style.borderColor='rgba(168,85,247,0.35)'; this.style.background='rgba(168,85,247,0.04)'"
                     ondrop="handleDrop(event)">
                    <div id="dropIcon" style="font-size:36px; margin-bottom:8px; opacity:0.6;">📸</div>
                    <div id="dropText" style="color:var(--text-muted); font-size:13.5px; font-weight:500;">Kéo thả ảnh vào đây hoặc click để chọn file</div>
                    <div style="color:var(--text-muted); font-size:11.5px; margin-top:6px;">Hỗ trợ: JPG, PNG, WEBP — Tối đa 5MB</div>
                </div>

                <input type="file" id="fileInput" name="AnhFile" accept="image/*" style="display:none;" onchange="previewFile(this)" required />

                <!-- Preview ảnh đã chọn -->
                <div id="previewWrap" style="display:none; margin-bottom:16px; text-align:center; position:relative;">
                    <img id="previewImg" src="" alt="Preview" style="max-height:180px; border-radius:10px; border:1px solid rgba(168,85,247,0.3); object-fit:contain; max-width:100%;" />
                    <button type="button" onclick="clearPreview()" style="position:absolute; top:6px; right:6px; background:rgba(0,0,0,0.7); border:none; border-radius:50%; width:26px; height:26px; color:#fff; font-size:14px; cursor:pointer;">&times;</button>
                </div>

                <!-- Mô tả -->
                <div style="margin-bottom:16px;">
                    <label style="font-size:12.5px; color:var(--text-muted); font-weight:500; display:block; margin-bottom:6px;">
                        <i class="bi bi-chat-text me-1"></i> Mô tả hình ảnh
                    </label>
                    <input type="text" name="MoTa" id="moTaInput" maxlength="255"
                           placeholder="VD: Màn hình bị vỡ góc trên bên trái, Pin bị phồng..."
                           style="width:100%; padding:10px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; outline:none; transition:border-color 0.2s;"
                           onfocus="this.style.borderColor='rgba(168,85,247,0.5)'"
                           onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
                </div>

                <!-- Thông báo lỗi / tiến trình -->
                <div id="uploadAlert" style="display:none; padding:10px 14px; border-radius:8px; font-size:13px; margin-bottom:12px;"></div>
            </div>

            <!-- Modal Footer -->
            <div style="padding:14px 22px; border-top:1px solid var(--border); display:flex; gap:10px;">
                <button type="button" onclick="closeUploadModal()"
                        style="flex:1; padding:10px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text-muted); font-size:13.5px; cursor:pointer;">
                    Hủy
                </button>
                <button type="submit" id="submitBtn"
                        style="flex:2; padding:10px; background:var(--primary); border:none; border-radius:999px; color:var(--on-primary); font-size:13.5px; font-weight:600; cursor:pointer; transition:all 0.2s;">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Tải ảnh lên
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ===== MODAL: XEM ẢNH TO ===== -->
<div id="viewModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.9); backdrop-filter:blur(8px); align-items:center; justify-content:center;" onclick="closeViewModal()">
    <img id="viewImg" src="" style="max-width:90vw; max-height:85vh; border-radius:10px; object-fit:contain; box-shadow:0 0 60px rgba(0,0,0,0.8);" />
    <div id="viewCaption" style="position:fixed; bottom:20px; left:50%; transform:translateX(-50%); color:rgba(255,255,255,0.7); font-size:13px; background:rgba(0,0,0,0.6); padding:6px 16px; border-radius:20px;"></div>
</div>

<!-- ===== MODAL: THÊM LINH KIỆN ===== -->
<div id="partModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.6); backdrop-filter:blur(8px); align-items:center; justify-content:center;">
    <div style="background:var(--surface); border:1px solid var(--border); border-radius:14px; width:520px; max-width:92vw; max-height:85vh; overflow:hidden; box-shadow:0 20px 40px rgba(0,0,0,0.4); display:flex; flex-direction:column;">
        <!-- Modal Header -->
        <div style="padding:16px 22px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; flex-shrink:0;">
            <div style="font-size:15px; font-weight:600; color:var(--text); display:flex; align-items:center; gap:8px;">
                <i class="bi bi-box-seam" style="color:var(--c-ok);"></i> Thêm linh kiện sửa chữa
            </div>
            <button type="button" onclick="closePartModal()" style="background:none; border:none; color:var(--text-muted); font-size:20px; cursor:pointer;">&times;</button>
        </div>

        <form id="frmAddPart" asp-controller="SuDungLinhKien" asp-action="XuatKho" method="post" style="display:flex; flex-direction:column; flex:1; overflow:hidden;">
            <input type="hidden" name="MaPhieu" value="@Model.MaPhieu" />
            <div style="padding:22px; overflow-y:auto; flex:1;">

                <!-- CHỌN LOẠI HÀNH ĐỘNG -->
                <div style="display:flex; gap:20px; margin-bottom:20px; background:var(--surface); padding:10px 14px; border-radius:8px; border:1px solid var(--border);">
                    <label style="color:var(--text); font-size:13px; display:flex; align-items:center; gap:6px; cursor:pointer;">
                        <input type="radio" name="LoaiHanhDong" value="ThayMoi" checked onchange="togglePartMode()" style="accent-color:#10b981;" /> Thay linh kiện (Kho)
                    </label>
                    <label style="color:var(--text); font-size:13px; display:flex; align-items:center; gap:6px; cursor:pointer;">
                        <input type="radio" name="LoaiHanhDong" value="SuaChua" onchange="togglePartMode()" style="accent-color:#10b981;" /> Sửa chữa / Dịch vụ
                    </label>
                </div>

                <div id="divThayMoi">

                @{
                    var goiYIds = ViewBag.GoiYLinhKienIds as List<int> ?? new List<int>();
                    var khoLK = ViewBag.KhoLinhKien as List<QuanLySuCoMayTinh.Models.LinhKien> ?? new List<QuanLySuCoMayTinh.Models.LinhKien>();
                    var goiYParts = khoLK.Where(lk => goiYIds.Contains(lk.MaLK)).ToList();
                    var otherParts = khoLK.Where(lk => !goiYIds.Contains(lk.MaLK)).ToList();
                }

                @if (Model.MaLoiNavigation != null && goiYParts.Any())
                {
                    <!-- GỢI Ý TỪ AI -->
                    <div style="margin-bottom:18px; padding:14px 16px; background:rgba(16,185,129,0.06); border:1px solid rgba(16,185,129,0.2); border-radius:10px;">
                        <div style="font-size:12px; font-weight:600; color:var(--c-ok); margin-bottom:10px; display:flex; align-items:center; gap:6px;">
                            <i class="bi bi-robot"></i> Gợi ý từ chẩn đoán AI
                            <span style="font-weight:400; color:var(--text-muted); font-size:11px; margin-left:4px;">— @Model.MaLoiNavigation.TenLoi</span>
                        </div>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                            @foreach (var lk in goiYParts)
                            {
                                <button type="button" class="part-suggest-pill" onclick="selectPart(@lk.MaLK)" data-malK="@lk.MaLK"
                                        style="padding:6px 12px; background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.3); border-radius:20px; color:var(--c-ok); font-size:11.5px; cursor:pointer; transition:all 0.2s; white-space:nowrap;">
                                    @lk.TenLK <span style="color:var(--text-muted);">(@string.Format("{0:N0}đ", lk.DonGia))</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Thanh tìm kiếm linh kiện -->
                <div style="margin-bottom:12px;">
                    <label style="font-size:12.5px; color:var(--text-muted); font-weight:500; display:block; margin-bottom:6px;">Linh kiện trong kho</label>
                    <input type="text" id="partSearchInput" placeholder="🔍 Tìm kiếm linh kiện..." oninput="filterParts(this.value)"
                           style="width:100%; padding:9px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:12.5px; outline:none; margin-bottom:8px; box-sizing:border-box;" />
                </div>

                <div style="margin-bottom:16px;">
                    <select name="MaLK" id="selLinhKien" class="form-select" required style="width:100%; padding:10px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; outline:none;" onchange="updatePriceHint(this)">
                        <option value="">-- Chọn linh kiện --</option>
                        @if (goiYParts.Any())
                        {
                            <optgroup label="⭐ Gợi ý phù hợp với chẩn đoán">
                                @foreach (var lk in goiYParts)
                                {
                                    <option value="@lk.MaLK" data-price="@lk.DonGia" data-stock="@lk.SoLuongTon" data-loai="@lk.LoaiLK">⭐ @lk.TenLK (Tồn: @lk.SoLuongTon)</option>
                                }
                            </optgroup>
                        }
                        <optgroup label="📦 Tất cả linh kiện">
                            @foreach (var lk in otherParts)
                            {
                                <option value="@lk.MaLK" data-price="@lk.DonGia" data-stock="@lk.SoLuongTon" data-loai="@lk.LoaiLK">@lk.TenLK (Tồn: @lk.SoLuongTon)</option>
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="row g-3" style="margin-bottom:16px;">
                    <div class="col-6">
                        <label style="font-size:12.5px; color:var(--text-muted); font-weight:500; display:block; margin-bottom:6px;">Số lượng</label>
                        <input type="number" name="SoLuong" id="inputSoLuong" min="1" value="1" required style="width:100%; padding:10px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; outline:none; box-sizing:border-box;" oninput="updatePriceHint(document.getElementById('selLinhKien'))" />
                    </div>
                    <div class="col-6">
                        <label style="font-size:12.5px; color:var(--text-muted); font-weight:500; display:block; margin-bottom:6px;">Ghi chú (tùy chọn)</label>
                        <input type="text" name="GhiChu" placeholder="VD: Thay mới" style="width:100%; padding:10px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; outline:none; box-sizing:border-box;" />
                    </div>
                </div>

                <div id="priceHint" style="font-size:12.5px; color:var(--c-ok); font-weight:500; text-align:right; display:none; padding:10px 14px; background:rgba(16,185,129,0.06); border:1px solid rgba(16,185,129,0.15); border-radius:8px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="color:var(--text-muted);">Đơn giá:</span>
                        <span id="unitPrice">0 đ</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px; font-size:14px; font-weight:700;">
                        <span style="color:var(--text-muted);">Thành tiền:</span>
                        <span id="totalPrice" style="color:var(--c-ok);">0 đ</span>
                    </div>
                </div>
                </div> <!-- End divThayMoi -->

                <!-- KHU VỰC SỬA CHỮA (Ẩn Mặc định) -->
                <div id="divSuaChua" style="display:none;">
                    <div style="margin-bottom:16px;">
                        <label style="font-size:12.5px; color:var(--text-muted); font-weight:500; display:block; margin-bottom:6px;">Tên dịch vụ / sửa chữa</label>
                        <input type="text" id="txtTenHangMuc" name="TenHangMuc" placeholder="VD: Cài Windows, Sửa bản lề..." style="width:100%; padding:10px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; outline:none; box-sizing:border-box;" />
                    </div>
                    <div style="margin-bottom:16px;">
                        <label style="font-size:12.5px; color:var(--text-muted); font-weight:500; display:block; margin-bottom:6px;">Phí dịch vụ</label>
                        <input type="number" id="txtChiPhiDV" name="ChiPhiDV" value="0" min="0" style="width:100%; padding:10px 14px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; outline:none; box-sizing:border-box;" />
                    </div>
                </div>

            </div>

            <!-- Modal Footer -->
            <div style="padding:14px 22px; border-top:1px solid var(--border); display:flex; gap:10px; flex-shrink:0;">
                <button type="button" onclick="closePartModal()"
                        style="flex:1; padding:10px; background:var(--surface); border:1px solid var(--border); border-radius:8px; color:var(--text-muted); font-size:13.5px; cursor:pointer;">
                    Hủy
                </button>
                <button type="submit"
                        style="flex:2; padding:10px; background:linear-gradient(135deg,#22c55e,#10b981); border:none; border-radius:8px; color:#fff; font-size:13.5px; font-weight:600; cursor:pointer; box-shadow:0 4px 14px rgba(34,197,94,0.3); transition:all 0.2s;">
                    <i class="bi bi-check2 me-1"></i> Xác nhận thêm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // ── Part Modal ──
    function openPartModal()  { document.getElementById('partModal').style.display = 'flex'; }
    function closePartModal() { document.getElementById('partModal').style.display = 'none'; }

    function togglePartMode() {
        var mode = document.querySelector('input[name="LoaiHanhDong"]:checked').value;
        var frm = document.getElementById('frmAddPart');
        var selLK = document.getElementById('selLinhKien');
        var inputSL = document.getElementById('inputSoLuong');
        var txtHangMuc = document.getElementById('txtTenHangMuc');

        if (mode === 'ThayMoi') {
            document.getElementById('divThayMoi').style.display = 'block';
            document.getElementById('divSuaChua').style.display = 'none';
            frm.action = '/SuDungLinhKien/XuatKho';
            selLK.setAttribute('required', 'required');
            inputSL.setAttribute('required', 'required');
            txtHangMuc.removeAttribute('required');
        } else {
            document.getElementById('divThayMoi').style.display = 'none';
            document.getElementById('divSuaChua').style.display = 'block';
            frm.action = '/ChiTietSuaChua/ThemDichVu';
            selLK.removeAttribute('required');
            inputSL.removeAttribute('required');
            txtHangMuc.setAttribute('required', 'required');
        }
    }
    
    function selectPart(maLK) {
        const sel = document.getElementById('selLinhKien');
        if (sel) {
            sel.value = maLK;
            updatePriceHint(sel);
            
            // Highlight pill
            document.querySelectorAll('.part-suggest-pill').forEach(btn => {
                btn.style.background = 'rgba(16,185,129,0.12)';
                btn.style.borderColor = 'rgba(16,185,129,0.3)';
                btn.style.boxShadow = 'none';
            });
            const clickedBtn = document.querySelector(`.part-suggest-pill[data-malk="${maLK}"]`);
            if (clickedBtn) {
                clickedBtn.style.background = 'rgba(16,185,129,0.25)';
                clickedBtn.style.borderColor = '#10b981';
                clickedBtn.style.boxShadow = '0 0 10px rgba(16,185,129,0.2)';
            }
        }
    }

    let _originalParts = null;
    let _filterTimer = null;

    function filterParts(query) {
        clearTimeout(_filterTimer);
        _filterTimer = setTimeout(() => {
            query = query.toLowerCase();
            const sel = document.getElementById('selLinhKien');
            
            // Lấy danh sách gốc 1 lần duy nhất
            if (!_originalParts) {
                _originalParts = [];
                Array.from(sel.options).forEach(opt => {
                    if (opt.value === "") return;
                    _originalParts.push({
                        value: opt.value, text: opt.text,
                        price: opt.getAttribute('data-price'),
                        stock: opt.getAttribute('data-stock'),
                        loai: opt.getAttribute('data-loai'),
                        group: opt.parentElement.tagName === 'OPTGROUP' ? opt.parentElement.label : ''
                    });
                });
            }

            // Xóa toàn bộ option cũ
            sel.innerHTML = '<option value="">-- Chọn linh kiện --</option>';
            
            let lastGroup = null;
            let optGroupEl = null;

            // Build lại danh sách dựa trên filter
            _originalParts.forEach(p => {
                const textMatch = p.text.toLowerCase().includes(query);
                const loaiMatch = p.loai && p.loai.toLowerCase().includes(query);
                
                if (textMatch || loaiMatch) {
                    if (p.group && p.group !== lastGroup) {
                        optGroupEl = document.createElement('optgroup');
                        optGroupEl.label = p.group;
                        sel.appendChild(optGroupEl);
                        lastGroup = p.group;
                    }
                    
                    const newOpt = document.createElement('option');
                    newOpt.value = p.value;
                    newOpt.text = p.text;
                    if (p.price) newOpt.setAttribute('data-price', p.price);
                    if (p.stock) newOpt.setAttribute('data-stock', p.stock);
                    if (p.loai) newOpt.setAttribute('data-loai', p.loai);

                    if (optGroupEl) {
                        optGroupEl.appendChild(newOpt);
                    } else {
                        sel.appendChild(newOpt);
                    }
                }
            });

            sel.value = "";
            updatePriceHint(sel);
        }, 150); // Debounce 150ms để gõ không bị khựng
    }

    function updatePriceHint(sel) {
        const opt = sel.options[sel.selectedIndex];
        const hint = document.getElementById('priceHint');
        const qtyInput = document.getElementById('inputSoLuong');
        
        if (opt && opt.value) {
            const price = parseFloat(opt.getAttribute('data-price'));
            const qty = parseInt(qtyInput.value) || 1;
            
            document.getElementById('unitPrice').textContent = price.toLocaleString('vi-VN') + ' đ';
            document.getElementById('totalPrice').textContent = (price * qty).toLocaleString('vi-VN') + ' đ';
            
            hint.style.display = 'block';
        } else {
            hint.style.display = 'none';
        }
    }

    // ── Upload Modal ──
    function openUploadModal()  { document.getElementById('uploadModal').style.display = 'flex'; }
    function closeUploadModal() { document.getElementById('uploadModal').style.display = 'none'; clearPreview(); }

    function previewFile(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        if (file.size > 5 * 1024 * 1024) {
            showUploadAlert('Ảnh vượt quá 5MB. Vui lòng chọn ảnh nhỏ hơn.', 'error');
            input.value = ''; return;
        }
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('previewImg').src = e.target.result;
            document.getElementById('previewWrap').style.display = 'block';
            document.getElementById('dropZone').style.display = 'none';
        };
        reader.readAsDataURL(file);
    }

    function clearPreview() {
        document.getElementById('fileInput').value = '';
        document.getElementById('previewWrap').style.display = 'none';
        document.getElementById('dropZone').style.display = 'block';
    }

    function handleDrop(e) {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            const dt = new DataTransfer();
            dt.items.add(file);
            document.getElementById('fileInput').files = dt.files;
            previewFile(document.getElementById('fileInput'));
        }
        e.currentTarget.style.borderColor = 'rgba(168,85,247,0.35)';
        e.currentTarget.style.background  = 'rgba(168,85,247,0.04)';
    }

    function showUploadAlert(msg, type) {
        const el = document.getElementById('uploadAlert');
        el.style.display = 'block';
        el.style.background = type === 'error' ? 'rgba(239,68,68,0.1)' : 'rgba(34,197,94,0.1)';
        el.style.border     = type === 'error' ? '1px solid rgba(239,68,68,0.3)' : '1px solid rgba(34,197,94,0.3)';
        el.style.color      = type === 'error' ? '#fca5a5' : '#4ade80';
        el.textContent = msg;
    }

    // Show delete buttons on hover
    document.querySelectorAll('.photo-card').forEach(card => {
        const btn = card.querySelector('.photo-delete-btn');
        card.addEventListener('mouseenter', () => { if(btn) btn.style.display = 'flex'; });
        card.addEventListener('mouseleave', () => { if(btn) btn.style.display = 'none'; });
    });

    // ── View Photo Modal ──
    function viewPhoto(src, caption) {
        document.getElementById('viewImg').src     = '/' + src;
        document.getElementById('viewCaption').textContent = caption || '';
        document.getElementById('viewModal').style.display = 'flex';
    }
    function closeViewModal() { document.getElementById('viewModal').style.display = 'none'; }

    // ── Delete Photo ──
    function deletePhoto(maHA) {
        showConfirm('Xóa ảnh này khỏi hồ sơ phiếu?', function() {
            fetch(`/HinhAnhSuCo/Delete/${maHA}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name=__RequestVerificationToken]').value }
            }).then(r => r.ok ? location.reload() : alert('Lỗi khi xóa ảnh'));
        });
    }

    // ── QR Upload Modal ──
    // Tự động chọn URL phù hợp:
    //   - localhost → dùng IP LAN để điện thoại kết nối được qua WiFi
    //   - domain thật (Somee, v.v.) → dùng nguyên domain + protocol
    (function buildQrUrl() {
        const hostname  = location.hostname;
        const port      = location.port ? ':' + location.port : '';
        const protocol  = location.protocol; // http: hoặc https:

        let host = hostname;
        // Khi debug local: thay localhost bằng IP LAN
        if (hostname === 'localhost' || hostname === '127.0.0.1') {
            const lanIp = '@(ViewBag.LocalIp ?? "")';
            if (lanIp && lanIp !== 'localhost' && lanIp !== '') {
                host = lanIp;
            }
        }

        // Dùng route dạng /{id} vì controller đã có [Route("HinhAnhSuCo/MobileUpload/{maPhieu:int}")]
        window.QR_UPLOAD_URL = `${protocol}//${host}${port}/HinhAnhSuCo/MobileUpload/@Model.MaPhieu`;
        window.QR_LAN_IP     = host;
    })();

    function openQrModal() {
        document.getElementById('qrModal').style.display = 'flex';
        // Generate QR if not done yet
        if (!window._qrGenerated) {
            window._qrGenerated = true;
            new QRCode(document.getElementById('qrCanvas'), {
                text: window.QR_UPLOAD_URL,
                width: 200,
                height: 200,
                colorDark: '#ffffff',
                colorLight: '#13131f',
                correctLevel: QRCode.CorrectLevel.M
            });
        }
        // Hien thi URL va IP dang dung
        document.getElementById('qrLinkText').textContent = window.QR_UPLOAD_URL;
        // Start polling for new photos every 5s
        startQrPolling();
    }

    function closeQrModal() {
        document.getElementById('qrModal').style.display = 'none';
        stopQrPolling();
    }

    // Auto-refresh photo grid while QR modal is open
    let _pollTimer = null;
    let _lastCount = @(Model.HinhAnhSuCos?.Count ?? 0);

    function startQrPolling() {
        _pollTimer = setInterval(async () => {
            try {
                const res = await fetch(`/HinhAnhSuCo/CountPhotos/@Model.MaPhieu`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.count > _lastCount) {
                    _lastCount = data.count;
                    document.getElementById('qrNewPhotoBadge').textContent = `+${data.count - @(Model.HinhAnhSuCos?.Count ?? 0)} ảnh mới · nhấn để tải lại`;
                    document.getElementById('qrNewPhotoBadge').style.display = 'block';
                }
            } catch {}
        }, 4000);
    }

    function stopQrPolling() {
        clearInterval(_pollTimer);
    }

    function copyQrLink() {
        navigator.clipboard.writeText(window.QR_UPLOAD_URL).then(() => {
            const btn = document.getElementById('copyLinkBtn');
            btn.textContent = '✅ Đã copy!';
            setTimeout(() => btn.textContent = '📋 Copy link', 2000);
        });
    }
</script>

<!-- ===== MODAL: QR UPLOAD ===== -->
<div id="qrModal" style="display:none; position:fixed; inset:0; z-index:9997; background:rgba(0,0,0,0.7); backdrop-filter:blur(8px); align-items:center; justify-content:center;">
    <div style="background:#13131f; border:1px solid rgba(168,85,247,0.3); border-radius:20px; padding:0; max-width:400px; width:92%; box-shadow:0 24px 70px rgba(0,0,0,0.6); overflow:hidden;">

        <!-- Header -->
        <div style="padding:18px 22px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; background:rgba(168,85,247,0.08);">
            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:38px; height:38px; background:var(--tint); color:var(--tint-x); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px;">
                    <i class="bi bi-qr-code"></i>
                </div>
                <div>
                    <div style="font-size:15px; font-weight:700; color:var(--text);">QR Upload ảnh</div>
                    <div style="font-size:11.5px; color:var(--text-muted);">Dùng điện thoại quét để chụp &amp; tải ảnh lên</div>
                </div>
            </div>
            <button onclick="closeQrModal()" style="background:var(--surface2); border:1px solid var(--border); border-radius:6px; width:30px; height:30px; color:var(--text-muted); cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center;">✕</button>
        </div>

        <!-- QR Code -->
        <div style="padding:28px; display:flex; flex-direction:column; align-items:center;">
            <div id="qrCanvas" style="background:#13131f; border-radius:12px; padding:16px; border:1px solid rgba(168,85,247,0.25);"></div>

            <!-- New photo badge -->
            <div id="qrNewPhotoBadge" onclick="location.reload()" style="display:none; margin-top:14px; background:rgba(34,197,94,0.12); border:1px solid rgba(34,197,94,0.3); color:var(--c-ok); border-radius:8px; padding:8px 14px; font-size:13px; font-weight:600; cursor:pointer; text-align:center;">
                📸 Có ảnh mới · nhấn để tải lại
            </div>

            <!-- Pulse status -->
            <div style="margin-top:14px; display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-muted);">
                <span style="display:inline-block; width:7px; height:7px; border-radius:50%; background:#22c55e; animation:pulse-dot 1.5s ease-in-out infinite;"></span>
                Đang chờ điện thoại tải ảnh...
            </div>

            <!-- Link copy -->
            <div style="width:100%; margin-top:18px; background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:10px 14px; display:flex; align-items:center; gap:8px;">
                <span id="qrLinkText" style="flex:1; font-size:11px; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"></span>
                <button id="copyLinkBtn" onclick="copyQrLink()" style="background:rgba(168,85,247,0.15); border:1px solid rgba(168,85,247,0.3); border-radius:6px; color:var(--c-purple); font-size:11.5px; font-weight:600; padding:5px 10px; cursor:pointer; white-space:nowrap;">📋 Copy link</button>
            </div>

            <!-- Instruction steps -->
            <div style="width:100%; margin-top:16px; background:var(--surface2); border-radius:10px; padding:14px; font-size:12px; color:var(--text-muted); line-height:1.9;">
                <div>① Mở ứng dụng camera trên điện thoại</div>
                <div>② Quét mã QR ở trên</div>
                <div>③ Chụp ảnh hoặc chọn từ thư viện</div>
                <div>④ Ảnh tự động xuất hiện trong hồ sơ phiếu</div>
            </div>

            <a href="@Url.Action("MobileUpload","HinhAnhSuCo", new { maPhieu = Model.MaPhieu })" target="_blank"
               style="margin-top:14px; font-size:12px; color:rgba(168,85,247,0.7); text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="bi bi-box-arrow-up-right"></i> Mở trang upload trực tiếp
            </a>
        </div>
    </div>
</div>

<style>
@@keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
}
</style>

<!-- QR Code library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // QR Code for Review
        const qrReviewEl = document.getElementById('qrReviewDetails');
        if (qrReviewEl) {
            var hostStr = '@(ViewBag.LocalIp != "localhost" ? ViewBag.LocalIp : "")';
            var port = '@(ViewBag.Port)';
            var scheme = '@(ViewBag.Scheme)';
            
            var reviewUrl = window.location.origin;
            if (hostStr && hostStr !== '') {
                reviewUrl = scheme + '://' + hostStr + (port ? ':' + port : '');
            }
            reviewUrl += '/PhieuTiepNhan/DanhGiaPublic/@Model.MaPhieu';
            
            new QRCode(qrReviewEl, {
                text: reviewUrl,
                width: 140,
                height: 140,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
        }

        // SLA Timer Logic
        const timerEl = document.getElementById('sla-timer');
        if (timerEl) {
            const startTime = new Date(timerEl.dataset.start).getTime();
            
            function updateTimer() {
                const now = new Date().getTime();
                let diff = now - startTime;
                
                // Nếu diff âm (có thể do sai lệch múi giờ), set bằng 0
                if (diff < 0) diff = 0;

                const hours = Math.floor(diff / (1000 * 60 * 60));
                const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const secs = Math.floor((diff % (1000 * 60)) / 1000);

                let formatted = 
                    String(hours).padStart(2, '0') + ':' + 
                    String(mins).padStart(2, '0') + ':' + 
                    String(secs).padStart(2, '0');

                // Cập nhật màu sắc badge SLA
                if (hours >= 48) {
                    timerEl.style.background = 'rgba(186,66,78,0.14)';
                    timerEl.style.color = 'var(--c-err)';
                    timerEl.style.border = '1px solid var(--c-err)';
                    timerEl.innerHTML = '<i class="bi bi-exclamation-octagon"></i> SLA: ' + formatted;
                } else if (hours >= 24) {
                    timerEl.style.background = 'rgba(169,90,13,0.14)';
                    timerEl.style.color = 'var(--c-warn)';
                    timerEl.style.border = '1px solid var(--c-warn)';
                    timerEl.innerHTML = '<i class="bi bi-exclamation-triangle"></i> SLA: ' + formatted;
                } else {
                    timerEl.style.background = 'rgba(0,100,140,0.10)';
                    timerEl.style.color = 'var(--c-info)';
                    timerEl.style.border = '1px solid var(--c-info)';
                    timerEl.innerHTML = '<i class="bi bi-clock-history"></i> SLA: ' + formatted;
                }
            }
            
            updateTimer();
            setInterval(updateTimer, 1000);
        }
    });
</script>
}
