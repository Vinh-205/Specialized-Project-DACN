@model QuanLySuCoMayTinh.Models.LinhKien

@{
    ViewData["Title"] = "Thêm Linh Kiện Mới";
}

<style>
.lk-page { color:var(--text); max-width: 800px; margin: 0 auto; }
.lk-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius: 16px;
    padding: 30px;
    backdrop-filter: blur(20px);
}
.lk-card-header {
    display: flex; align-items: center; gap: 14px; margin-bottom: 24px;
    padding-bottom: 16px; border-bottom:1px solid var(--border);
}
.lk-icon {
    width: 42px; height: 42px;
    background: var(--primary);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; box-shadow: 0 4px 15px rgba(168,85,247,0.3);
}
.lk-title { font-size: 18px; font-weight: 700; }
.lk-sub { font-size: 12.5px; color:var(--text-muted); margin-top: 2px; }

.form-group { margin-bottom: 20px; }
.control-label {
    display: block; font-size: 13px; font-weight: 500;
    color:var(--text-muted); margin-bottom: 8px;
}
.form-control {
    width: 100%; padding: 10px 14px;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius: 8px; color:var(--text);
    transition: all 0.2s;
}
.form-control:focus {
    background:var(--surface);
    border-color: rgba(168,85,247,0.5); outline: none;
    box-shadow: 0 0 0 3px rgba(168,85,247,0.15);
}
.text-danger { color:var(--c-err); font-size: 12px; margin-top: 4px; display: block; }

.switch-wrap { display: flex; align-items: center; gap: 10px; cursor: pointer; }
.switch-wrap input { display: none; }
.switch-slider {
    width: 44px; height: 24px; background:var(--surface2);
    border-radius: 20px; position: relative; transition: 0.3s;
}
.switch-slider::before {
    content: ""; position: absolute; width: 18px; height: 18px;
    border-radius: 50%; background: #fff; top: 3px; left: 3px; transition: 0.3s;
}
.switch-wrap input:checked + .switch-slider { background: #4ade80; box-shadow: 0 0 10px rgba(74,222,128,0.3); }
.switch-wrap input:checked + .switch-slider::before { transform: translateX(20px); }

.lk-actions {
    display: flex; gap: 12px; margin-top: 30px;
    padding-top: 20px; border-top:1px solid var(--border);
}
.btn-save {
    background: var(--primary);
    color: #fff; border: none; padding: 10px 24px; border-radius: 8px;
    font-weight: 600; cursor: pointer; transition: 0.2s; flex: 1;
}
.btn-save:hover { box-shadow: 0 6px 20px rgba(168,85,247,0.4); transform: translateY(-2px); }
.btn-back {
    background:var(--surface); color:var(--text); border:1px solid var(--border);
    padding: 10px 24px; border-radius: 8px; text-decoration: none; text-align: center;
    font-weight: 500; transition: 0.2s; flex: 1;
}
.btn-back:hover { background:var(--surface2); color:var(--text); }
</style>

<div class="lk-page">
    <div class="lk-card">
        <div class="lk-card-header">
            <div class="lk-icon"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="lk-title">Nhập mới Linh Kiện</div>
                <div class="lk-sub">Thêm mặt hàng mới vào danh mục kho</div>
            </div>
        </div>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-7">
                    <div class="form-group">
                        <label asp-for="TenLK" class="control-label"></label>
                        <input asp-for="TenLK" class="form-control" placeholder="VD: RAM DDR4 8GB Kingston" />
                        <span asp-validation-for="TenLK" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label asp-for="LoaiLK" class="control-label"></label>
                        <input asp-for="LoaiLK" class="form-control" placeholder="VD: RAM, Ổ cứng, Màn hình..." />
                        <span asp-validation-for="LoaiLK" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SoLuongTon" class="control-label"></label>
                        <input asp-for="SoLuongTon" class="form-control" type="number" min="0" placeholder="Số lượng ban đầu" />
                        <span asp-validation-for="SoLuongTon" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DonGia" class="control-label"></label>
                        <input asp-for="DonGia" class="form-control" type="number" min="0" placeholder="Giá bán (VNĐ)" />
                        <span asp-validation-for="DonGia" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label mb-2">Trạng thái kinh doanh</label>
                <label class="switch-wrap">
                    <input asp-for="CoTrangThai" />
                    <div class="switch-slider"></div>
                    <span style="font-size:13px; color:var(--text-muted); margin-left:6px;">Đang kinh doanh</span>
                </label>
            </div>

            <div class="lk-actions">
                <a asp-action="Index" class="btn-back"><i class="bi bi-arrow-left"></i> Quay lại</a>
                <button type="submit" class="btn-save"><i class="bi bi-check2"></i> Lưu linh kiện</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
