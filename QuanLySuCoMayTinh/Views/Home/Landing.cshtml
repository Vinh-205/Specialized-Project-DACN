@{
    Layout = null;
    var chapters = new[] {
        new { Title = "Tiếp nhận sự cố", Tag = "Mọi thông tin, một điểm bắt đầu.", Text = "Ghi nhận thiết bị, khách hàng và mô tả sự cố. Mỗi yêu cầu có một phiếu để theo dõi xuyên suốt quá trình xử lý.", Icon = "ticket-detailed", Note = "Thiết bị / Khách hàng / Triệu chứng", Image = "proposals/helpdesk-workspace.png" },
        new { Title = "Chẩn đoán cùng DeskAI", Tag = "Từ triệu chứng đến hướng giải quyết.", Text = "Kết nối triệu chứng với mã lỗi và giải pháp tham khảo. DeskAI hỗ trợ phân tích để kỹ thuật viên đưa ra quyết định xử lý.", Icon = "stars", Note = "Triệu chứng / Mã lỗi / Giải pháp", Image = "proposals/helpdesk-knowledge.png" },
        new { Title = "Theo dõi sửa chữa", Tag = "Rõ từng bước. Liền mạch từng việc.", Text = "Gắn hạng mục sửa chữa, linh kiện sử dụng và chi phí vào phiếu. Cập nhật tiến độ để thông tin luôn theo sát công việc.", Icon = "tools", Note = "Hạng mục / Linh kiện / Tiến độ", Image = "proposals/helpdesk-workspace.png" },
        new { Title = "Kết nối tri thức", Tag = "Kinh nghiệm hôm nay, giải pháp ngày mai.", Text = "Tra cứu mã lỗi và giải pháp trong kho tri thức. Kết hợp thông tin hỗ trợ, báo cáo và đánh giá để nhìn lại quá trình phục vụ.", Icon = "book", Note = "Mã lỗi / Tra cứu / Đánh giá", Image = "proposals/helpdesk-knowledge.png" }
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_SystemIcons" />
    <link href="~/css/public-motion.css" rel="stylesheet" asp-append-version="true">
    <script src="~/js/public-motion.js" defer asp-append-version="true"></script>
    <link href="~/css/scroll-showcase.css" rel="stylesheet" asp-append-version="true">
    <script src="~/js/scroll-showcase.js" defer asp-append-version="true"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Khám phá IT Helpdesk: tiếp nhận sự cố, chẩn đoán cùng DeskAI, quản lý sửa chữa và kết nối tri thức.">
    <title>IT Helpdesk | Sổ tay hệ thống</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/helpdesk-sketchbook.css" rel="stylesheet" asp-append-version="true">
    <script src="~/js/helpdesk-sketchbook.js" defer asp-append-version="true"></script>
</head>
<body class="sketchbook-page">
    <header class="sk-top">
        <a class="sk-brand" href="@Url.Action("Welcome", "Home")"><i class="bi bi-pc-display" aria-hidden="true"></i> IT HELPDESK</a>
        <nav aria-label="Điều hướng chính">
            <a href="#showcase">Khám phá</a>
            <a href="#sketchbook">Sổ tay</a>
            <a href="#about">Hệ thống</a>
            <a href="#plates">Mục lục</a>
            <a class="sk-login" href="@Url.Action("Login", "Auth")">Đăng nhập <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        </nav>
    </header>
    <main>
        <partial name="~/Views/Home/_ScrollShowcase.cshtml" />
        <section class="landing-illustration" aria-labelledby="overviewTitle">
            <h2 id="overviewTitle">Toàn cảnh IT Helpdesk</h2>
            <a href="@Url.Content("~/images/proposals/helpdesk-workspace.png")" target="_blank" rel="noopener" aria-label="Xem ảnh toàn cảnh hệ thống ở kích thước gốc">
                <img src="~/images/proposals/helpdesk-workspace.png" alt="Bàn sửa chữa IT Helpdesk với máy tính, màn hình chẩn đoán, trợ lý CRT, linh kiện và tài liệu kỹ thuật." width="1536" height="1024" loading="lazy">
            </a>
        </section>
        <section class="sk-hero" id="sketchbook" aria-label="Sổ tay IT Helpdesk">
            <div class="sk-desk">
                <div class="sk-intro">
                    <p class="sk-kicker">CON NGƯỜI · CÔNG NGHỆ · GIẢI PHÁP</p>
                    <h1>IT Helpdesk</h1>
                    <p>Một cuốn sổ. Trọn hành trình hỗ trợ.</p>
                </div>
                <div class="sb-stage" role="region" aria-roledescription="carousel" aria-label="Các chương giới thiệu" tabindex="0">
                    <button class="sb-arrow js-control" type="button" data-step="-1" aria-label="Chương trước" title="Chương trước"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
                    <div class="sb-book" id="helpdeskBook">
                        @for (var i = 0; i < chapters.Length; i++)
                        {
                            var chapter = chapters[i];
                            <article class="sb-spread" id="chapter-@i" data-chapter="@i" aria-label="@($"{i + 1} / {chapters.Length}: {chapter.Title}")">
                                <div class="sb-page sb-writing">
                                    <div class="sb-page-top"><span>SỔ TAY HỆ THỐNG</span><i class="bi bi-@chapter.Icon" aria-hidden="true"></i></div>
                                    <span class="sb-number">0@(i + 1)</span>
                                    <h2>@chapter.Title</h2>
                                    <p class="sb-tag">@chapter.Tag</p>
                                    <p class="sb-description">@chapter.Text</p>
                                    <div class="sb-folio">IT HELPDESK <span>0@(i * 2 + 1)</span></div>
                                </div>
                                <div class="sb-page sb-art">
                                    <p class="sb-art-label"><i class="bi bi-circle-fill" aria-hidden="true"></i> @(i == 1 ? "DESKAI INTELLIGENCE" : "IT HELPDESK PLATFORM")</p>
                                    <div class="sb-picture">
                                        <img src="@Url.Content("~/images/" + chapter.Image)" alt="@chapter.Title - minh họa các lớp của hệ thống IT Helpdesk" loading="@(i == 0 ? "eager" : "lazy")" draggable="false">
                                        <div class="sb-lens" aria-hidden="true"></div>
                                    </div>
                                    <p class="sb-art-note">@chapter.Note</p>
                                    <div class="sb-folio">MINH HỌA HỆ THỐNG <span>0@(i * 2 + 2)</span></div>
                                </div>
                            </article>
                        }
                    </div>
                    <button class="sb-arrow js-control" type="button" data-step="1" aria-label="Chương sau" title="Chương sau"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
                <div class="sb-bottom js-control">
                    <p class="sb-caption" id="bookCaption" role="status" aria-live="polite">01 / 04 · Tiếp nhận sự cố</p>
                    <div class="sb-tools" role="group" aria-label="Công cụ xem sổ tay">
                        <button type="button" id="zoomOut" aria-label="Thu nhỏ" title="Thu nhỏ"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                        <output id="zoomRead" aria-label="Mức phóng đại">100%</output>
                        <button type="button" id="zoomIn" aria-label="Phóng to" title="Phóng to"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                        <span class="tool-separator"></span>
                        <button type="button" id="zoomReset" aria-label="Đặt lại kích thước" title="Đặt lại kích thước"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                        <button type="button" id="loupeToggle" aria-label="Kính lúp" title="Kính lúp" aria-pressed="false"><i class="bi bi-search" aria-hidden="true"></i></button>
                    </div>
                </div>
                <a class="sk-down" href="#about" aria-label="Giới thiệu hệ thống" title="Giới thiệu hệ thống"><i class="bi bi-arrow-down" aria-hidden="true"></i></a>
            </div>
        </section>
        <section id="about" class="sk-about">
            <p class="sk-kicker">VỀ HỆ THỐNG</p>
            <h2>Chăm sóc thiết bị.<br><em>Kết nối con người.</em></h2>
            <div class="sk-about-body">
                <p>IT Helpdesk tập hợp phiếu tiếp nhận, chẩn đoán, sửa chữa và tri thức trong cùng một không gian làm việc. DeskAI đồng hành cùng kỹ thuật viên ở bước phân tích, để mỗi sự cố có một hướng xử lý rõ ràng.</p>
                <a class="sk-entry" href="@Url.Action("Login", "Auth")">Vào không gian làm việc <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
        </section>
        <section id="plates" class="sk-plates">
            <div class="sk-index-heading"><p class="sk-kicker">MỤC LỤC</p><span>04 chương / Một hệ thống</span></div>
            <ol class="plate-list">
                @for (var i = 0; i < chapters.Length; i++)
                {
                    <li><a class="plate" href="#chapter-@i" data-goto="@i"><span class="n">0@(i + 1)</span><span class="t">@chapters[i].Title</span><span class="p">@chapters[i].Note</span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></li>
                }
            </ol>
        </section>
    </main>
    <footer class="sk-footer"><a href="@Url.Action("Welcome", "Home")">IT HELPDESK</a><span>Quản lý sự cố máy tính · DeskAI</span><a href="@Url.Action("Login", "Auth")">Đăng nhập <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></footer>
</body>
</html>
