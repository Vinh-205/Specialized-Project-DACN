@model IEnumerable<QuanLySuCoMayTinh.Models.DanhGiaDichVu>

@{
    ViewData["Title"] = "Đánh giá khách hàng";

    int totalReviews = (int)(ViewData["TotalReviews"] ?? 0);
    double avgRating = (double)(ViewData["AvgRating"] ?? 0.0);
    int[] starDist = ViewData["StarDist"] as int[] ?? new int[5];
    int maxStar = starDist.Max() > 0 ? starDist.Max() : 1;
}

<style>
.review-page { color:var(--text); }

.review-hero {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 24px;
    backdrop-filter: blur(20px);
    position: relative; overflow: hidden;
}
.review-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(250,204,21,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(250,204,21,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

.review-hero-icon {
    width: 44px; height: 44px;
    background: linear-gradient(135deg, #f59e0b, #facc15);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; box-shadow: 0 6px 20px rgba(245,158,11,0.4);
    color: #fff;
}

.review-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    gap: 16px;
    margin-bottom: 24px;
}

.review-stat-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius: 14px;
    padding: 22px 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.review-stat-card .stat-big {
    font-size: 42px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    margin: 6px 0;
}

.review-stat-card .stat-label {
    font-size: 12px;
    color:var(--text-muted);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: .5px;
}

.star-dist-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius: 14px;
    padding: 22px 24px;
}

.star-dist-card .dist-title {
    font-size: 13px;
    font-weight: 600;
    color:var(--text-muted);
    margin-bottom: 14px;
}

.dist-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.dist-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color:var(--text-muted);
    min-width: 50px;
    justify-content: flex-end;
}

.dist-bar-bg {
    flex: 1;
    height: 8px;
    background:var(--surface);
    border-radius: 4px;
    overflow: hidden;
}

.dist-bar-fill {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, #f59e0b, #facc15);
    transition: width 0.6s ease;
}

.dist-count {
    font-size: 12px;
    color:var(--text-muted);
    min-width: 28px;
    text-align: right;
    font-family: 'JetBrains Mono', monospace;
}

/* Review cards */
.review-list { margin-top: 8px; }

.review-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 12px;
    display: flex;
    gap: 16px;
    transition: all 0.2s;
    text-decoration: none;
    color: inherit;
}

.review-card:hover {
    background:var(--surface2);
    border-color: rgba(250,204,21,0.3);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
}

.review-avatar {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; font-weight: 700; color:var(--text); flex-shrink: 0;
}

.review-body { flex: 1; min-width: 0; }

.review-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.review-customer {
    font-size: 14px;
    font-weight: 600;
    color:var(--text);
}

.review-stars {
    display: flex;
    gap: 2px;
}

.review-stars i {
    font-size: 14px;
    color: #facc15;
}

.review-stars i.empty {
    color:var(--text-light);
}

.review-comment {
    font-size: 13.5px;
    color:var(--text-muted);
    line-height: 1.6;
    margin-bottom: 8px;
}

.review-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color:var(--text-muted);
}

.review-meta i { margin-right: 3px; }

.review-empty {
    text-align: center;
    padding: 60px 20px;
    color:var(--text-light);
}

.review-empty i {
    font-size: 48px;
    display: block;
    margin-bottom: 12px;
    opacity: 0.4;
}

@@media (max-width: 768px) {
    .review-stats { grid-template-columns: 1fr; }
}
</style>

<div class="review-page">
    <!-- Hero -->
    <div class="review-hero">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div style="font-size:22px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:12px;">
                    <div class="review-hero-icon"><i class="bi bi-star-fill"></i></div>
                    Đánh giá khách hàng
                </div>
                <div style="color:var(--text-muted);font-size:13px;margin-top:6px;">
                    Tổng hợp phản hồi từ khách hàng sau khi hoàn thành sửa chữa — Dữ liệu trực tiếp từ QR trên hóa đơn
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted);">
                <span style="width:7px;height:7px;border-radius:50%;background:#facc15;display:inline-block;box-shadow:0 0 6px #facc15;"></span>
                @totalReviews đánh giá
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="review-stats">
        <!-- Tổng đánh giá -->
        <div class="review-stat-card">
            <div class="stat-label">Tổng đánh giá</div>
            <div class="stat-big" style="color:var(--c-info);">@totalReviews</div>
            <div style="font-size:12px; color:var(--text-muted);">Từ khách hàng</div>
        </div>

        <!-- Điểm trung bình -->
        <div class="review-stat-card">
            <div class="stat-label">Điểm trung bình</div>
            <div class="stat-big" style="color:#facc15;">@avgRating</div>
            <div style="display:flex;justify-content:center;gap:3px;margin-top:2px;">
                @for (int i = 1; i <= 5; i++)
                {
                    var filled = i <= Math.Round(avgRating);
                    <i class="bi @(filled ? "bi-star-fill" : "bi-star")" style="color:@(filled ? "#facc15" : "rgba(255,255,255,0.15)");font-size:16px;"></i>
                }
            </div>
        </div>

        <!-- Phân bổ sao -->
        <div class="star-dist-card">
            <div class="dist-title"><i class="bi bi-bar-chart-line me-1"></i> Phân bổ đánh giá</div>
            @for (int s = 5; s >= 1; s--)
            {
                double pct = totalReviews > 0 ? (double)starDist[s - 1] / maxStar * 100 : 0;
                <div class="dist-row">
                    <div class="dist-label">
                        @s <i class="bi bi-star-fill" style="color:#facc15;font-size:11px;"></i>
                    </div>
                    <div class="dist-bar-bg">
                        <div class="dist-bar-fill" style="width:@pct.ToString("F0")%;"></div>
                    </div>
                    <div class="dist-count">@starDist[s - 1]</div>
                </div>
            }
        </div>
    </div>

    <!-- Danh sách đánh giá -->
    <div style="font-size:15px; font-weight:600; color:var(--text); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
        <i class="bi bi-chat-quote-fill" style="color:#facc15;"></i>
        Tất cả đánh giá
    </div>

    <div class="review-list">
        @if (Model.Any())
        {
            @foreach (var dg in Model)
            {
                var khachTen = dg.PhieuTiepNhan?.ThietBi?.KhachHang?.HoTen ?? "Khách hàng";
                var ktvTen = dg.PhieuTiepNhan?.User_KTV?.FullName ?? "N/A";
                var thietBiTen = dg.PhieuTiepNhan?.ThietBi?.TenTB ?? "—";
                var bgGrad = dg.SoSao >= 4 ? "linear-gradient(135deg,#22c55e,#10b981)" :
                             dg.SoSao == 3 ? "linear-gradient(135deg,#f59e0b,#eab308)" :
                             "linear-gradient(135deg,#ef4444,#f87171)";

                <a href="@Url.Action("Details", "PhieuTiepNhan", new { id = dg.MaPhieu })" class="review-card">
                    <div class="review-avatar" style="background:@bgGrad;">
                        @khachTen.Substring(0, 1).ToUpper()
                    </div>
                    <div class="review-body">
                        <div class="review-header">
                            <span class="review-customer">@khachTen</span>
                            <div class="review-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= dg.SoSao ? "bi-star-fill" : "bi-star") @(i > dg.SoSao ? "empty" : "")"></i>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(dg.BinhLuan))
                        {
                            <div class="review-comment">"@dg.BinhLuan"</div>
                        }
                        else
                        {
                            <div class="review-comment" style="font-style:italic; color:var(--text-light);">Không có bình luận</div>
                        }
                        <div class="review-meta">
                            <span><i class="bi bi-ticket-detailed"></i> Phiếu #HD-@dg.MaPhieu.ToString("D4")</span>
                            <span><i class="bi bi-laptop"></i> @thietBiTen</span>
                            <span><i class="bi bi-person-gear"></i> KTV: @ktvTen</span>
                            <span><i class="bi bi-clock"></i> @dg.NgayDG.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="review-empty">
                <i class="bi bi-chat-square-dots"></i>
                <div style="font-size:16px; font-weight:500; color:var(--text-muted);">Chưa có đánh giá nào</div>
                <div style="font-size:13px; margin-top:6px;">Khi khách hàng quét QR trên hóa đơn và gửi đánh giá, chúng sẽ hiển thị tại đây.</div>
            </div>
        }
    </div>
</div>
