@model Tuple<IEnumerable<QuanLySuCoMayTinh.Models.PhieuTiepNhan>, IEnumerable<QuanLySuCoMayTinh.Models.DanhGiaDichVu>>

@if (Model.Item1 != null && Model.Item1.Any())
{
    foreach(var p in Model.Item1)
    {
        <a href="@Url.Action("Details", "PhieuTiepNhan", new { id = p.MaPhieu })" class="notif-item">
            <div class="notif-icon"><i class="bi bi-file-earmark-plus-fill"></i></div>
            <div class="notif-content">
                <div class="notif-title">
                    Khách hàng <b>@(p.ThietBi?.KhachHang?.HoTen ?? "Khách lẻ")</b> vừa tạo đơn sửa chữa thiết bị <b>@(p.ThietBi?.TenTB ?? "—")</b>.
                </div>
                <div class="notif-time">@p.NgayNhan.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </a>
    }
}
@if (Model.Item2 != null && Model.Item2.Any())
{
    <div style="padding:10px 16px 4px; font-size:11px; color:var(--text-light); font-weight:600; text-transform:uppercase; letter-spacing:.5px; border-top:1px solid var(--border);">
        <i class="bi bi-star-fill" style="color:#facc15;"></i> Đánh giá từ khách hàng
    </div>
    foreach (var dg in Model.Item2)
    {
        <a href="@Url.Action("Details", "PhieuTiepNhan", new { id = dg.MaPhieu })" class="notif-item">
            <div class="notif-icon" style="background:rgba(250,204,21,0.15); color:#facc15;">
                <i class="bi bi-star-fill"></i>
            </div>
            <div class="notif-content">
                <div class="notif-title">
                    <b>@(dg.PhieuTiepNhan?.ThietBi?.KhachHang?.HoTen ?? "Khách hàng")</b> đánh giá
                    @for (int s = 0; s < dg.SoSao; s++) { <i class="bi bi-star-fill" style="color:#facc15;font-size:10px;"></i> }
                </div>
                @if (!string.IsNullOrEmpty(dg.BinhLuan))
                {
                    <div style="font-size:11.5px; color:var(--text-muted); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:220px;">"@dg.BinhLuan"</div>
                }
                <div class="notif-time">@dg.NgayDG.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </a>
    }
}
@if ((Model.Item1 == null || !Model.Item1.Any()) && (Model.Item2 == null || !Model.Item2.Any()))
{
    <div style="padding:20px; text-align:center; color:var(--text-muted); font-size:13px;">
        <i class="bi bi-bell-slash" style="font-size:24px; display:block; margin-bottom:8px; opacity:0.5;"></i>
        Chưa có thông báo nào
    </div>
}
