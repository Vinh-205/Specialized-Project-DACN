@model QuanLySuCoMayTinh.Models.TrieuChung

@{
    ViewData["Title"] = "Thêm Triệu Chứng";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 text-dark fw-bold">Thêm Triệu Chứng Mới</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="TenTC" class="form-label fw-bold">Tên triệu chứng (Biểu hiện) <span class="text-danger">*</span></label>
                            <input asp-for="TenTC" class="form-control" placeholder="Ví dụ: Màn hình xanh, Kêu bíp..." required />
                            <span asp-validation-for="TenTC" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả chi tiết</label>
                            <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Mô tả cụ thể biểu hiện..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold">Thêm mới</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>